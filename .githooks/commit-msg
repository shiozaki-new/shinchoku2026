#!/bin/sh
# コミットに書いたIssue番号が実在することを確認する。
set -u
command -v gh >/dev/null 2>&1 || exit 0
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 0
refs=$(grep -v '^# ' "$1" | grep -oE '#[0-9]+' | tr -d '#' | sort -u || true)
[ -n "$refs" ] || exit 0
for number in $refs; do
  if ! gh api "repos/$repo/issues/$number" --silent >/dev/null 2>&1; then
    if gh api "repos/$repo" --silent >/dev/null 2>&1; then
      echo "存在しないIssue #$number をコミットへ書けない。先にIssueを作成する。" >&2
      exit 1
    fi
  fi
done
